# ============================================
# Ostim BLogic Mikroelektronik
# Makefile.uvm  -  UVM testbench derleme akisi
#
# 5 blok: GPIO + Timer + UART_0 + I2C + YZ hizlandirici (AXI-Lite CSR + AXI4 master)
# Her blok kendi tb ust modulu ve obj dizini ile derlenir;
# agent/monitor/driver ortak (axi_lite_uvm_pkg),
# blok-ozel scoreboard/test'ler periph_uvm_pkg'de (YZ: ai_uvm_pkg).
# ============================================

# UVM 2020-3.1 (verilator/uvm 656f20d) Verilator >= 5.052 ister (13 Eylul 2026'dan beri main'de).
# Oncelik: komut satiri / ortam VERILATOR, sonra ~/tools/verilator-5.052, sonra PATH.
VERILATOR_MIN ?= 5.052
VERILATOR     ?= $(firstword $(wildcard $(HOME)/tools/verilator-5.052/bin/verilator) verilator)
UVM_JOBS  ?= 2   # WSL'de fazla paralellik OOM yapiyor
TOP_MODULE = uvm_pkg

# UVM kutuphanesi vendor edilmis, clone gerekmez
UVM_HOME   = verif/uvm-lib/src
UVM_PKG    = $(UVM_HOME)/uvm_pkg.sv

# Ortak dogrulama kaynaklari
COMMON_SV  = verif/uvm/axi_lite_if.sv \
             verif/uvm/axi_lite_uvm_pkg.sv \
             verif/uvm/periph_uvm_pkg.sv

# Blok kaynak listeleri (RTL + tb)
GPIO_SRCS  = $(COMMON_SV) \
             rtl/peripherals/gpio_axil.sv \
             verif/uvm/tb_top.sv

TIMER_SRCS = $(COMMON_SV) \
             rtl/peripherals/timer_axil.sv \
             verif/uvm/tb_timer_top.sv

UART_SRCS  = $(COMMON_SV) \
             rtl/peripherals/uart_axil.sv \
             rtl/peripherals/verilog-uart/rtl/uart_tx.v \
             rtl/peripherals/verilog-uart/rtl/uart_rx.v \
             verif/uvm/tb_uart_top.sv

I2C_SRCS   = $(COMMON_SV) \
             rtl/peripherals/i2c_master_axil.sv \
             verif/uvm/tb_i2c_top.sv

# YZ hizlandirici: AXI-Lite CSR ortak agent ile, AXI4 master TB bellek modeliyle
AI_SRCS    = $(COMMON_SV) \
             verif/uvm/ai_side_if.sv \
             verif/uvm/ai_uvm_pkg.sv \
             rtl/ai_accelerator/ai_accelerator.sv \
             verif/uvm/tb_ai_top.sv

# Eski degisken adi (geri uyumluluk)
SV_SOURCES = $(GPIO_SRCS)

# Dizinler
OBJ_DIR       = obj_dir_uvm
OBJ_DIR_TIMER = obj_dir_uvm_timer
OBJ_DIR_UART  = obj_dir_uvm_uart
OBJ_DIR_I2C   = obj_dir_uvm_i2c
OBJ_DIR_AI    = obj_dir_uvm_ai
LOG_DIR       = build/uvm_logs
COV_DIR       = $(LOG_DIR)/coverage

# Blok binari yollari
GPIO_BIN   = $(OBJ_DIR)/V$(TOP_MODULE)
TIMER_BIN  = $(OBJ_DIR_TIMER)/V$(TOP_MODULE)
UART_BIN   = $(OBJ_DIR_UART)/V$(TOP_MODULE)
I2C_BIN    = $(OBJ_DIR_I2C)/V$(TOP_MODULE)
AI_BIN     = $(OBJ_DIR_AI)/V$(TOP_MODULE)

# Test isimleri
# Tohumlar: run_all rastgele testleri UVM_SEEDS'teki her tohumla kosar
# (+verilator+seed+N; UVM global tohumu buradan turer). run_one tek tohum.
UVM_SEEDS ?= 1 2 3
UVM_SEED  ?= $(firstword $(UVM_SEEDS))

UVM_TESTNAME  ?= gpio_directed_test
UVM_BIN       ?= $(GPIO_BIN)
ALL_TESTS      = gpio_directed_test gpio_random_test

# run_all icin (binari:test) ciftleri — 5 blok x (directed+random)
RUN_PAIRS = \
    $(GPIO_BIN):gpio_directed_test \
    $(GPIO_BIN):gpio_random_test \
    $(TIMER_BIN):timer_directed_test \
    $(TIMER_BIN):timer_random_test \
    $(UART_BIN):uart_directed_test \
    $(UART_BIN):uart_random_test \
    $(I2C_BIN):i2c_directed_test \
    $(I2C_BIN):i2c_random_test \
    $(AI_BIN):ai_directed_test \
    $(AI_BIN):ai_random_test

# Verilator flags
# COV_FLAG: tam kapsam (line+toggle). 5.049-devel I2C'de toggle
# enstrumantasyonunda Internal Error veriyordu (i2c_master_axil.sv:191);
# 5.052'de GPIO/Timer/UART/I2C ayni bayrakla derlenir.
# YZ hizlandirici: toggle enstrumantasyonu ~900 bin cevrimlik iki cikarimi
# gereksiz yavaslatir; SoC seviyesi kapsama zaten make coverage'ta -> line.
COV_FLAG = --coverage
$(AI_BIN):  COV_FLAG = --coverage-line

VERILATOR_FLAGS = \
    --main --binary --build --cc \
    --timing \
    --vpi \
    $(COV_FLAG) \
    -j $(UVM_JOBS) \
    --timescale 1ns/1ns

# UVM kutuphanesinin uyarilarini sustur
DISABLED_WARNINGS = \
    -Wno-DECLFILENAME -Wno-MISINDENT \
    -Wno-VARHIDDEN -Wno-WIDTHTRUNC -Wno-CASTCONST \
    -Wno-WIDTHEXPAND -Wno-UNDRIVEN -Wno-UNUSEDSIGNAL \
    -Wno-UNUSEDPARAM -Wno-SYMRSVDWORD -Wno-ZERODLY \
    -Wno-CASEINCOMPLETE -Wno-SIDEEFFECT -Wno-fatal \
    -Wno-REALCVT -Wno-MODDUP -Wno-TIMESCALEMOD \
    -Wno-UNSIGNED

INCDIRS = +incdir+"$(UVM_HOME)" \
          +incdir+verif/uvm \
          +incdir+rtl/peripherals

# UVM DPI acik: UVM 2020-3.1 her kosuda UVM_NO_DPI modunu kaldirmayi
# planladigini uyariyordu. uvm_dpi.cc (656f20d'deki Verilator VPI arka ucu
# uvm_hdl_verilator.c dahil) --vpi ile derlenir; +UVM_TESTNAME DPI'dan
# okunur ve bilesen adi denetimi calisir.
UVM_DPI_SRC = $(UVM_HOME)/dpi/uvm_dpi.cc
DEFINES     = +define+UVM_REPORT_DISABLE_FILE_LINE

# Hedefler
.PHONY: all directed random run_one run_all clean help \
        compile compile_timer compile_uart compile_i2c compile_all \
        timer_directed timer_random uart_directed uart_random \
        i2c_directed i2c_random compile_ai ai_directed ai_random check_solver

help:
	@echo "============================================="
	@echo " BLogic MCU — UVM Testbench (Verilator)"
	@echo " 5 blocks: GPIO, timer, UART_0, I2C and the AI accelerator"
	@echo "============================================="
	@echo "  make -f Makefile.uvm compile_all     Build all blocks"
	@echo "  make -f Makefile.uvm directed        GPIO directed"
	@echo "  make -f Makefile.uvm random          GPIO random"
	@echo "  make -f Makefile.uvm timer_directed  Timer directed"
	@echo "  make -f Makefile.uvm timer_random    Timer random"
	@echo "  make -f Makefile.uvm uart_directed   UART_0 directed"
	@echo "  make -f Makefile.uvm uart_random     UART_0 random"
	@echo "  make -f Makefile.uvm i2c_directed    I2C directed"
	@echo "  make -f Makefile.uvm i2c_random      I2C random"
	@echo "  make -f Makefile.uvm ai_directed     AI accelerator directed (2 inferences)"
	@echo "  make -f Makefile.uvm ai_random       AI accelerator random (z3) and inference"
	@echo "  make -f Makefile.uvm all             Clean build and 10 tests (random tests once per seed in UVM_SEEDS)"
	@echo "  make -f Makefile.uvm clean           Remove build output"
	@echo "============================================="

# Verilator surum kapisi: UVM 2020-3.1 eski surumle derlenmez
.PHONY: check_verilator
check_verilator:
	@v=$$($(VERILATOR) --version | awk '{print $$2}'); \
	low=$$(printf '%s\n%s\n' "$(VERILATOR_MIN)" "$$v" | sort -V | head -1); \
	if [ "$$low" != "$(VERILATOR_MIN)" ]; then \
		echo "ERROR: UVM 2020-3.1 needs Verilator $(VERILATOR_MIN) or later; found $$v ($(VERILATOR))"; \
		echo "       Install it in ~/tools/verilator-5.052 (scripts/install_verilator.sh) or pass VERILATOR=<path>."; exit 1; \
	fi; \
	echo ">>> Verilator $$v"

# Derleme (blok basina ayri obj dizini)
compile: $(GPIO_BIN)
compile_timer: $(TIMER_BIN)
compile_uart: $(UART_BIN)
compile_i2c: $(I2C_BIN)
compile_ai: $(AI_BIN)
compile_all: compile compile_timer compile_uart compile_i2c compile_ai

$(GPIO_BIN): $(GPIO_SRCS) $(UVM_PKG) | check_verilator
	@echo ""
	@echo ">>> Building the UVM testbench (GPIO)..."
	@mkdir -p $(LOG_DIR)
	$(VERILATOR) $(VERILATOR_FLAGS) --Mdir $(OBJ_DIR) $(DISABLED_WARNINGS) \
		$(DEFINES) $(INCDIRS) \
		$(UVM_PKG) $(GPIO_SRCS) $(UVM_DPI_SRC) \
		2>&1 | tee $(LOG_DIR)/compile.log
	@echo ">>> Built: $(GPIO_BIN)"

$(TIMER_BIN): $(TIMER_SRCS) $(UVM_PKG) | check_verilator
	@echo ""
	@echo ">>> Building the UVM testbench (timer)..."
	@mkdir -p $(LOG_DIR)
	$(VERILATOR) $(VERILATOR_FLAGS) --Mdir $(OBJ_DIR_TIMER) $(DISABLED_WARNINGS) \
		$(DEFINES) $(INCDIRS) \
		$(UVM_PKG) $(TIMER_SRCS) $(UVM_DPI_SRC) \
		2>&1 | tee $(LOG_DIR)/compile_timer.log
	@echo ">>> Built: $(TIMER_BIN)"

$(UART_BIN): $(UART_SRCS) $(UVM_PKG) | check_verilator
	@echo ""
	@echo ">>> Building the UVM testbench (UART_0)..."
	@mkdir -p $(LOG_DIR)
	$(VERILATOR) $(VERILATOR_FLAGS) --Mdir $(OBJ_DIR_UART) $(DISABLED_WARNINGS) \
		$(DEFINES) $(INCDIRS) \
		$(UVM_PKG) $(UART_SRCS) $(UVM_DPI_SRC) \
		2>&1 | tee $(LOG_DIR)/compile_uart.log
	@echo ">>> Built: $(UART_BIN)"

$(I2C_BIN): $(I2C_SRCS) $(UVM_PKG) | check_verilator
	@echo ""
	@echo ">>> Building the UVM testbench (I2C)..."
	@mkdir -p $(LOG_DIR)
	$(VERILATOR) $(VERILATOR_FLAGS) --Mdir $(OBJ_DIR_I2C) $(DISABLED_WARNINGS) \
		$(DEFINES) $(INCDIRS) \
		$(UVM_PKG) $(I2C_SRCS) $(UVM_DPI_SRC) \
		2>&1 | tee $(LOG_DIR)/compile_i2c.log
	@echo ">>> Built: $(I2C_BIN)"

$(AI_BIN): $(AI_SRCS) $(UVM_PKG) | check_verilator
	@echo ""
	@echo ">>> Building the UVM testbench (AI accelerator)..."
	@mkdir -p $(LOG_DIR)
	$(VERILATOR) $(VERILATOR_FLAGS) --Mdir $(OBJ_DIR_AI) $(DISABLED_WARNINGS) \
		$(DEFINES) $(INCDIRS) \
		$(UVM_PKG) $(AI_SRCS) $(UVM_DPI_SRC) \
		2>&1 | tee $(LOG_DIR)/compile_ai.log
	@echo ">>> Built: $(AI_BIN)"

# Tek test kos (UVM_BIN + UVM_TESTNAME ile parametrik)
# Not: binari onkosulu kisayol hedeflerinde — hedefe-ozel degiskenler
# onkosul listesinde genislemez (GNU make), recipe'de genisler.
run_one:
	@echo ""
	@echo ">>> UVM Test: $(UVM_TESTNAME)"
	@mkdir -p $(COV_DIR)
	./$(UVM_BIN) \
		+UVM_TESTNAME="$(UVM_TESTNAME)" \
		+UVM_VERBOSITY=UVM_MEDIUM \
		+UVM_NO_RELNOTES +verilator+seed+$(UVM_SEED) \
		+verilator+coverage+file+$(COV_DIR)/$(UVM_TESTNAME).cov \
		2>&1 | tee $(LOG_DIR)/$(UVM_TESTNAME).log
	@echo ""
	@echo "--- UVM report summary ---"
	@grep -E "UVM_ERROR|UVM_FATAL|PROTO_RPT|SB_RPT|COV_RPT|SCOREBOARD|PROTOCOL" \
		$(LOG_DIR)/$(UVM_TESTNAME).log || true
	@echo ""

# Constrained-random kapisi: Verilator randomize() kisitlarini calisma aninda
# harici SMT cozucusuyle (varsayilan "z3 --in") cozer. z3 yoksa randomize()
# basarisiz olur; bu UVM_ERROR (axi_lite_uvm_pkg.sv, periph_uvm_pkg.sv), ama
# kosuya hic baslamadan net mesajla durmak daha iyi. Kurulum: README 8.2.
check_solver:
	@command -v z3 >/dev/null 2>&1 || { \
		echo "ERROR: z3 was not found; the constrained-random tests cannot run without it."; \
		echo "      sudo apt install z3   ya da   python3 -m venv ~/z3venv && ~/z3venv/bin/pip install z3-solver"; \
		echo "       (with the venv: export PATH=~/z3venv/bin:\$$PATH)"; exit 1; }
	@echo ">>> Constraint solver: $$(z3 --version)"

# Tum testleri kos: yonlendirilmis testler bir kez, rastgele testler
# UVM_SEEDS'teki her tohumla. Varsayilan: 5 + 5 x 3 = 20 kosu.
run_all: check_solver compile_all
	@echo ""
	@echo ">>> Running all UVM tests (5 blocks, 10 tests; seeds for the random tests: $(UVM_SEEDS))..."
	@mkdir -p $(COV_DIR)
	@pass=0; fail=0; runs=0; \
	for pair in $(RUN_PAIRS); do \
		bin=$${pair%%:*}; testname=$${pair##*:}; \
		case $$testname in \
			*_random_test) seeds="$(UVM_SEEDS)";; \
			*) seeds="$(UVM_SEED)";; \
		esac; \
		for seed in $$seeds; do \
			log=$(LOG_DIR)/$${testname}_s$${seed}.log; \
			echo ""; \
			echo "=== UVM test: $$testname, seed $$seed ($$bin) ==="; \
			./$$bin \
				+UVM_TESTNAME="$$testname" \
				+UVM_VERBOSITY=UVM_MEDIUM \
				+UVM_NO_RELNOTES +verilator+seed+$$seed \
				+verilator+coverage+file+$(COV_DIR)/$${testname}_s$${seed}.cov \
				2>&1 | tee $$log; \
			runs=$$((runs + 1)); \
			if grep -q "UVM_ERROR :    0" $$log && \
			   grep -q "UVM_FATAL :    0" $$log; then \
				echo ">>> $$testname (seed $$seed): PASS (log: $$log)"; \
				pass=$$((pass + 1)); \
			else \
				echo ">>> $$testname (seed $$seed): FAIL (log: $$log)"; \
				fail=$$((fail + 1)); \
			fi; \
		done; \
	done; \
	echo ""; \
	echo "============================================"; \
	echo " UVM regression: $$pass PASS, $$fail FAIL ($$runs runs; each random test with $(words $(UVM_SEEDS)) seeds)"; \
	echo " Logs: $(LOG_DIR)/<test>_s<seed>.log, coverage: $(COV_DIR)/"; \
	echo "============================================"; \
	exit $$fail

# Kisa yollar — GPIO (geri uyumlu)
directed: UVM_TESTNAME=gpio_directed_test
directed: UVM_BIN=$(GPIO_BIN)
directed: $(GPIO_BIN) run_one

random: UVM_TESTNAME=gpio_random_test
random: UVM_BIN=$(GPIO_BIN)
random: check_solver $(GPIO_BIN) run_one

# Kisa yollar — Timer
timer_directed: UVM_TESTNAME=timer_directed_test
timer_directed: UVM_BIN=$(TIMER_BIN)
timer_directed: $(TIMER_BIN) run_one

timer_random: UVM_TESTNAME=timer_random_test
timer_random: UVM_BIN=$(TIMER_BIN)
timer_random: $(TIMER_BIN) run_one

# Kisa yollar — UART_0
uart_directed: UVM_TESTNAME=uart_directed_test
uart_directed: UVM_BIN=$(UART_BIN)
uart_directed: $(UART_BIN) run_one

uart_random: UVM_TESTNAME=uart_random_test
uart_random: UVM_BIN=$(UART_BIN)
uart_random: $(UART_BIN) run_one

# Kisa yollar — I2C
i2c_directed: UVM_TESTNAME=i2c_directed_test
i2c_directed: UVM_BIN=$(I2C_BIN)
i2c_directed: $(I2C_BIN) run_one

i2c_random: UVM_TESTNAME=i2c_random_test
i2c_random: UVM_BIN=$(I2C_BIN)
i2c_random: $(I2C_BIN) run_one

# Kisa yollar — YZ hizlandirici (random da z3 ister)
ai_directed: UVM_TESTNAME=ai_directed_test
ai_directed: UVM_BIN=$(AI_BIN)
ai_directed: $(AI_BIN) run_one

ai_random: UVM_TESTNAME=ai_random_test
ai_random: UVM_BIN=$(AI_BIN)
ai_random: check_solver $(AI_BIN) run_one

# check_solver en basta: z3 yoksa temizlik ve bes binarinin derlenmesinden once durur
all: check_solver clean compile_all run_all

# Temizlik
clean:
	rm -rf $(OBJ_DIR) $(OBJ_DIR_TIMER) $(OBJ_DIR_UART) $(OBJ_DIR_I2C) $(OBJ_DIR_AI) $(LOG_DIR)
	@echo ">>> UVM build output removed"
