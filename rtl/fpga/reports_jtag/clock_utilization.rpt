# Location of BUFG Primitives 
set_property LOC BUFGCTRL_X0Y2 [get_cells FSM_sequential_state_q_reg[1]_i_2]
set_property LOC BUFGCTRL_X0Y1 [get_cells cnt_q_reg[1]_i_2]
set_property LOC BUFGCTRL_X0Y0 [get_cells i_bufg_50]

# Location of IO Primitives which is load of clock spine

# Location of clock ports
set_property LOC IOB_X1Y75 [get_ports sysclk_n]
set_property LOC IOB_X1Y76 [get_ports sysclk_p]

# Clock net "i_dmi_jtag/tck" driven by instance "FSM_sequential_state_q_reg[1]_i_2" located at site "BUFGCTRL_X0Y2"
#startgroup
create_pblock {CLKAG_i_dmi_jtag/tck}
add_cells_to_pblock [get_pblocks  {CLKAG_i_dmi_jtag/tck}] [get_cells -filter { PRIMITIVE_GROUP != I/O && IS_PRIMITIVE==1 && PRIMITIVE_LEVEL !=INTERNAL } -of_object [get_pins -filter {DIRECTION==IN} -of_objects [get_nets -hierarchical -filter {PARENT=="i_dmi_jtag/tck"}]]]
resize_pblock [get_pblocks {CLKAG_i_dmi_jtag/tck}] -add {CLOCKREGION_X0Y2:CLOCKREGION_X0Y2}
#endgroup

# Clock net "i_cpu/core_i/clk" driven by instance "cnt_q_reg[1]_i_2" located at site "BUFGCTRL_X0Y1"
#startgroup
create_pblock {CLKAG_i_cpu/core_i/clk}
add_cells_to_pblock [get_pblocks  {CLKAG_i_cpu/core_i/clk}] [get_cells -filter { PRIMITIVE_GROUP != I/O && IS_PRIMITIVE==1 && PRIMITIVE_LEVEL !=INTERNAL } -of_object [get_pins -filter {DIRECTION==IN} -of_objects [get_nets -hierarchical -filter {PARENT=="i_cpu/core_i/clk"}]]]
resize_pblock [get_pblocks {CLKAG_i_cpu/core_i/clk}] -add {CLOCKREGION_X0Y1:CLOCKREGION_X0Y1 CLOCKREGION_X0Y2:CLOCKREGION_X0Y2 CLOCKREGION_X1Y1:CLOCKREGION_X1Y1 CLOCKREGION_X1Y2:CLOCKREGION_X1Y2}
#endgroup

# Clock net "clk_50" driven by instance "i_bufg_50" located at site "BUFGCTRL_X0Y0"
#startgroup
create_pblock {CLKAG_clk_50}
add_cells_to_pblock [get_pblocks  {CLKAG_clk_50}] [get_cells -filter { PRIMITIVE_GROUP != I/O && IS_PRIMITIVE==1 && PRIMITIVE_LEVEL !=INTERNAL } -of_object [get_pins -filter {DIRECTION==IN} -of_objects [get_nets -hierarchical -filter {PARENT=="clk_50"}]]]
resize_pblock [get_pblocks {CLKAG_clk_50}] -add {CLOCKREGION_X0Y1:CLOCKREGION_X0Y1 CLOCKREGION_X0Y2:CLOCKREGION_X0Y2 CLOCKREGION_X0Y3:CLOCKREGION_X0Y3 CLOCKREGION_X1Y2:CLOCKREGION_X1Y2 CLOCKREGION_X1Y3:CLOCKREGION_X1Y3}
#endgroup
