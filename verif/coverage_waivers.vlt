// CV32E40P vendor agaci coverage kapsami disi (soc_files.f'ten uretildi):
//  - upstream'de dogrulanmis vendor IP
//  - Verilator 5.049 --coverage bu dosyalarda internal error veriyor
//    (cv32e40p_decoder.sv:1577, cv32e40p_register_file_ff.sv:122)
// Ekip RTL'i (bus, peripherals, ai_accelerator, soc_top) kapsamda kalir.
coverage_off -file "rtl/core/cv32e40p/rtl/vendor/pulp_platform_common_cells/src/cf_math_pkg.sv"
coverage_off -file "rtl/core/cv32e40p/rtl/vendor/pulp_platform_fpnew/src/fpnew_pkg.sv"
coverage_off -file "rtl/core/cv32e40p/rtl/include/cv32e40p_pkg.sv"
coverage_off -file "rtl/core/cv32e40p/rtl/include/cv32e40p_apu_core_pkg.sv"
coverage_off -file "rtl/core/cv32e40p/rtl/include/cv32e40p_fpu_pkg.sv"
coverage_off -file "rtl/core/cv32e40p/bhv/cv32e40p_sim_clock_gate.sv"
coverage_off -file "rtl/core/cv32e40p/rtl/vendor/pulp_platform_common_cells/src/fifo_v3.sv"
coverage_off -file "rtl/core/cv32e40p/rtl/vendor/pulp_platform_common_cells/src/lzc.sv"
coverage_off -file "rtl/core/cv32e40p/rtl/vendor/pulp_platform_common_cells/src/rr_arb_tree.sv"
coverage_off -file "rtl/core/cv32e40p/rtl/vendor/pulp_platform_common_cells/src/spill_register.sv"
coverage_off -file "rtl/core/cv32e40p/rtl/vendor/pulp_platform_common_cells/src/counter.sv"
coverage_off -file "rtl/core/cv32e40p/rtl/vendor/pulp_platform_common_cells/src/delta_counter.sv"
