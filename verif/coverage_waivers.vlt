coverage_off -file "rtl/core/cv32e40p/rtl/cv32e40p_compressed_decoder.sv"
coverage_off -file "rtl/core/cv32e40p/rtl/cv32e40p_controller.sv"
coverage_off -file "rtl/core/cv32e40p/rtl/cv32e40p_cs_registers.sv"
coverage_off -file "rtl/core/cv32e40p/rtl/cv32e40p_decoder.sv"
coverage_off -file "rtl/core/cv32e40p/rtl/cv32e40p_ex_stage.sv"
coverage_off -file "rtl/core/cv32e40p/rtl/cv32e40p_ff_one.sv"
coverage_off -file "rtl/core/cv32e40p/rtl/cv32e40p_fifo.sv"
coverage_off -file "rtl/core/cv32e40p/rtl/cv32e40p_fp_wrapper.sv"
