coverage_off -file "rtl/core/cv32e40p/rtl/vendor/pulp_platform_common_cells/src/stream_arbiter_flushable.sv"
coverage_off -file "rtl/core/cv32e40p/rtl/vendor/pulp_platform_common_cells/src/fall_through_register.sv"
coverage_off -file "rtl/core/cv32e40p/rtl/vendor/pulp_platform_common_cells/src/addr_decode.sv"
coverage_off -file "rtl/core/cv32e40p/rtl/vendor/pulp_platform_common_cells/src/onehot_to_bin.sv"
coverage_off -file "rtl/core/cv32e40p/rtl/cv32e40p_aligner.sv"
