# =============================================================================
# BLogic MCU - Verilator Simulasyon Makefile
# =============================================================================

SHELL := /bin/bash
.SHELLFLAGS := -o pipefail -c

VERILATOR    = verilator
RV_GCC       = riscv32-unknown-elf-gcc
RV_OBJCOPY   = riscv32-unknown-elf-objcopy
RV_OBJDUMP   = riscv32-unknown-elf-objdump
PYTHON       = python3

BUILD_DIR    = build
OBJ_DIR      = obj_dir
RTL_DIR      = rtl
VERIF_DIR    = verif
SW_DIR       = sw

LOG_ROOT     = $(CURDIR)/logs
LOG_BUILD    = $(LOG_ROOT)/build

SOC_FILES    = soc_files.f
SIM_MAIN     = $(VERIF_DIR)/tb/sim_main.cpp
TOP_MODULE   = soc_top
SIM_EXE      = $(OBJ_DIR)/blogic_sim

RV_ARCH      = rv32imc
RV_ABI       = ilp32
RV_CFLAGS    = -march=$(RV_ARCH) -mabi=$(RV_ABI) -nostdlib -O2 $(EXTRA_CFLAGS)
LINKER_SCRIPT = $(SW_DIR)/common/link.ld
STARTUP      = $(SW_DIR)/common/crt0.S

FW_SRC       ?= $(SW_DIR)/tests/uart_hello.c
TEST_NAME    := $(basename $(notdir $(FW_SRC)))
SIM_LOG_DIR  := $(LOG_ROOT)/sim/$(TEST_NAME)

VERILATOR_FLAGS = \
    --cc --timing \
    -Wno-fatal \
    -Wno-TIMESCALEMOD \
    -Wno-WIDTHEXPAND \
    -Wno-WIDTHTRUNC \
    -Wno-MODDUP \
    -Wno-CASEINCOMPLETE \
    -Wno-UNSIGNED \
    -DVERILATOR \
    --top-module $(TOP_MODULE) -public-flat-rw

ifdef TRACE
VERILATOR_FLAGS += --trace
endif

ifdef COVERAGE
VERILATOR_FLAGS += --coverage-line verif/coverage_waivers.vlt
endif

.PHONY: all sim clean sw verilate help logs-prep logs-clean

all: sim

help:
	@echo "═══════════════════════════════════════════"
	@echo " BLogic MCU - Build Hedefleri"
	@echo "═══════════════════════════════════════════"
	@echo "  sw       - Yazilimi derle"
	@echo "  verilate - Verilator ile RTL derle"
	@echo "  sim      - Tam simulasyon"
	@echo "  sim TRACE=1 / COVERAGE=1"
	@echo "  sim FW_SRC=sw/tests/gpio_led_test.c"
	@echo "  clean / logs-clean"
	@echo " Loglar: logs/  (yapi icin logs/README.md)"

logs-prep:
	@mkdir -p $(LOG_BUILD) $(SIM_LOG_DIR)

sw: logs-prep $(BUILD_DIR)/instr_mem.hex $(BUILD_DIR)/data_mem.hex

$(BUILD_DIR)/test.elf: $(STARTUP) $(FW_SRC) $(LINKER_SCRIPT) | logs-prep
	@mkdir -p $(BUILD_DIR)
	@echo "[SW] gcc ($(TEST_NAME)) -> $@"
	@$(RV_GCC) $(RV_CFLAGS) -T $(LINKER_SCRIPT) $(STARTUP) $(FW_SRC) -o $@ \
	    2>&1 | tee $(LOG_BUILD)/sw_build.log

$(BUILD_DIR)/test.disasm: $(BUILD_DIR)/test.elf
	@$(RV_OBJDUMP) -d $< > $@

$(BUILD_DIR)/instr_mem.hex: $(BUILD_DIR)/test.elf
	@$(RV_OBJCOPY) -O binary -j .text.init -j .text $< $(BUILD_DIR)/instr.bin
	@$(PYTHON) scripts/elf2hex.py $(BUILD_DIR)/instr.bin $@ 2>&1 | tee -a $(LOG_BUILD)/sw_build.log

$(BUILD_DIR)/data_mem.hex: $(BUILD_DIR)/test.elf
	@$(RV_OBJCOPY) -O binary -j .rodata -j .data $< $(BUILD_DIR)/data.bin 2>/dev/null \
	    || printf '' > $(BUILD_DIR)/data.bin
	@$(PYTHON) scripts/elf2hex.py $(BUILD_DIR)/data.bin $@ 2>&1 | tee -a $(LOG_BUILD)/sw_build.log

verilate: $(SIM_EXE)

$(SIM_EXE): $(SOC_FILES) $(SIM_MAIN) | logs-prep
	@echo "[VLT] Verilator -> $(LOG_BUILD)/verilator_build.log"
	@$(VERILATOR) $(VERILATOR_FLAGS) -f $(SOC_FILES) --exe $(SIM_MAIN) -o blogic_sim \
	    2>&1 | tee $(LOG_BUILD)/verilator_build.log
	@echo "[VLT] C++ derleniyor..."
	@make -C $(OBJ_DIR) -f V$(TOP_MODULE).mk blogic_sim -j$$(nproc) \
	    2>&1 | tee -a $(LOG_BUILD)/verilator_build.log

sim: $(BUILD_DIR)/instr_mem.hex $(BUILD_DIR)/data_mem.hex $(SIM_EXE)
	@mkdir -p $(SIM_LOG_DIR)
	@rm -f $(SIM_LOG_DIR)/result.log $(SIM_LOG_DIR)/diag.log
	@echo ""
	@echo "═══ Sim: $(TEST_NAME) (logs: $(SIM_LOG_DIR)) ═══"
	@mkdir -p $(OBJ_DIR)
	@cp $(BUILD_DIR)/instr_mem.hex $(OBJ_DIR)/firmware.hex
	@cp $(BUILD_DIR)/data_mem.hex  $(OBJ_DIR)/data_mem.hex
	@if [ -f sw/ai_model/golden_vectors/ai_sram_init.hex ]; then cp sw/ai_model/golden_vectors/ai_sram_init.hex $(OBJ_DIR)/ai_sram_init.hex; fi
	@cd $(OBJ_DIR) && ./blogic_sim +CPB=432 +TEST_NAME=$(TEST_NAME) +LOGDIR=$(SIM_LOG_DIR) \
	    2>&1 | tee $(SIM_LOG_DIR)/stdout.log
	@echo ""
	@echo "[SIM] Karar:" && grep "^result=" $(SIM_LOG_DIR)/result.log

clean:
	rm -rf $(OBJ_DIR) $(BUILD_DIR)
	@echo "[CLEAN] obj_dir/ ve build/ silindi (loglar duruyor)"

logs-clean:
	rm -rf $(LOG_ROOT)
	@echo "[CLEAN] logs/ silindi"
