# ============================================
# Ostim BLogic Mikroelektronik
# Makefile.verilator  -  Verilator simulasyon yapisi
# ============================================

SHELL := /bin/bash
.SHELLFLAGS := -o pipefail -c

VERILATOR    = verilator
RV_GCC       = riscv32-unknown-elf-gcc
RV_OBJCOPY   = riscv32-unknown-elf-objcopy
RV_OBJDUMP   = riscv32-unknown-elf-objdump
PYTHON       = python3

BUILD_DIR    = build
OBJ_DIR      = obj_dir
RTL_DIR      = rtl
VERIF_DIR    = verif
SW_DIR       = sw

LOG_ROOT     = $(CURDIR)/logs
LOG_BUILD    = $(LOG_ROOT)/build

SOC_FILES    = soc_files.f
SIM_MAIN     = $(VERIF_DIR)/tb/sim_main.cpp
TOP_MODULE   = soc_top
SIM_EXE      = $(OBJ_DIR)/blogic_sim

RV_ARCH      = rv32imc
RV_ABI       = ilp32
RV_CFLAGS    = -march=$(RV_ARCH) -mabi=$(RV_ABI) -nostdlib -O2 $(EXTRA_CFLAGS)
LINKER_SCRIPT = $(SW_DIR)/common/link.ld
STARTUP      = $(SW_DIR)/common/crt0.S

FW_SRC       ?= $(SW_DIR)/tests/uart_hello.c
# MEM_TRACE=1: also write every CPU load and store to <logs>/mem_trace.log (large)
MEM_TRACE    ?= 0
# Ek sim plusarg'lari (orn. +SWEEP=434,50,5208)
SIM_PLUSARGS ?=
TEST_NAME    := $(basename $(notdir $(FW_SRC)))
SIM_LOG_DIR  := $(LOG_ROOT)/sim/$(TEST_NAME)

VERILATOR_FLAGS = \
    --cc --timing \
    -Wno-fatal \
    -Wno-TIMESCALEMOD \
    -Wno-WIDTHEXPAND \
    -Wno-WIDTHTRUNC \
    -Wno-MODDUP \
    -Wno-CASEINCOMPLETE \
    -Wno-UNSIGNED \
    -Wno-UNOPTFLAT \
    -DVERILATOR \
    --top-module $(TOP_MODULE) -public-flat-rw

ifdef TRACE
VERILATOR_FLAGS += --trace
endif

ifdef COVERAGE
VERILATOR_FLAGS += --coverage-line verif/coverage_waivers.vlt
endif

.PHONY: all sim clean sw verilate help logs-prep logs-clean

all: sim

help:
	@echo "═══════════════════════════════════════════"
	@echo " BLogic MCU - simulation build targets (Makefile.verilator)"
	@echo "═══════════════════════════════════════════"
	@echo "  sw       - build the program"
	@echo "  verilate - build the Verilator model of the SoC"
	@echo "  sim      - build both and run the simulation"
	@echo "  sim TRACE=1 / COVERAGE=1"
	@echo "  sim FW_SRC=sw/tests/gpio_led_test.c"
	@echo "  clean / logs-clean"
	@echo " Logs: logs/ (layout described in logs/README.md)"

logs-prep:
	@mkdir -p $(LOG_BUILD) $(SIM_LOG_DIR)

sw: logs-prep $(BUILD_DIR)/instr_mem.hex $(BUILD_DIR)/data_mem.hex

# FW_SRC damgasi: kaynak dosya adi degisince (ama mtime'i eski olsa da)
# test.elf yeniden derlenir. Onceden 'make sim FW_SRC=<baska>' bayat ELF'i
# kosturabiliyordu (2-3 Eylul 2026'da iki kez yasandi). Damga yalniz icerik
# degisince yeniden yazilir -> ayni FW_SRC ile gereksiz derleme yok.
$(BUILD_DIR)/fw_src.stamp: FORCE
	@mkdir -p $(BUILD_DIR)
	@echo "$(FW_SRC)" | cmp -s - $@ 2>/dev/null || echo "$(FW_SRC)" > $@
FORCE:
.PHONY: FORCE

$(BUILD_DIR)/test.elf: $(STARTUP) $(FW_SRC) $(LINKER_SCRIPT) $(BUILD_DIR)/fw_src.stamp | logs-prep
	@mkdir -p $(BUILD_DIR)
	@echo "[SW] Compiling $(FW_SRC) -> $@"
	@$(RV_GCC) $(RV_CFLAGS) -T $(LINKER_SCRIPT) $(STARTUP) $(FW_SRC) -o $@ \
	    2>&1 | tee $(LOG_BUILD)/sw_build.log
	@# link.ld .srodata/.sdata/.sbss toplamazsa sessizce kaybolur (9 Agu 2026)
	@bash scripts/check_srodata.sh $@

$(BUILD_DIR)/test.disasm: $(BUILD_DIR)/test.elf
	@$(RV_OBJDUMP) -d $< > $@

$(BUILD_DIR)/instr_mem.hex: $(BUILD_DIR)/test.elf
	@$(RV_OBJCOPY) -O binary -j .text.init -j .text $< $(BUILD_DIR)/instr.bin
	@$(PYTHON) scripts/elf2hex.py $(BUILD_DIR)/instr.bin $@ 2>&1 | tee -a $(LOG_BUILD)/sw_build.log

$(BUILD_DIR)/data_mem.hex: $(BUILD_DIR)/test.elf
	@$(RV_OBJCOPY) -O binary -j .rodata -j .data $< $(BUILD_DIR)/data.bin 2>/dev/null \
	    || printf '' > $(BUILD_DIR)/data.bin
	@$(PYTHON) scripts/elf2hex.py $(BUILD_DIR)/data.bin $@ 2>&1 | tee -a $(LOG_BUILD)/sw_build.log

verilate: $(SIM_EXE)

$(SIM_EXE): $(SOC_FILES) $(SIM_MAIN) | logs-prep
	@echo "[VLT] Converting the RTL to C++ with Verilator (log: $(LOG_BUILD)/verilator_build.log)"
	@$(VERILATOR) $(VERILATOR_FLAGS) $(VLT_EXTRA) --Mdir $(OBJ_DIR) -f $(SOC_FILES) --exe $(SIM_MAIN) -o blogic_sim \
	    2>&1 | tee $(LOG_BUILD)/verilator_build.log
	@echo "[VLT] Compiling the C++ model..."
	@make -C $(OBJ_DIR) -f V$(TOP_MODULE).mk blogic_sim -j$$(nproc) \
	    2>&1 | tee -a $(LOG_BUILD)/verilator_build.log

sim: $(BUILD_DIR)/instr_mem.hex $(BUILD_DIR)/data_mem.hex $(SIM_EXE)
	@mkdir -p $(SIM_LOG_DIR)
	@rm -f $(SIM_LOG_DIR)/result.log $(SIM_LOG_DIR)/diag.log $(SIM_LOG_DIR)/report.txt \
	      $(SIM_LOG_DIR)/bus_trace.log $(SIM_LOG_DIR)/bus_summary.tsv $(SIM_LOG_DIR)/mem_trace.log
	@echo ""
	@echo "═══ Simulation: $(TEST_NAME) (logs: $(SIM_LOG_DIR)) ═══"
	@mkdir -p $(OBJ_DIR)
	@cp $(BUILD_DIR)/instr_mem.hex $(OBJ_DIR)/firmware.hex
	@cp $(BUILD_DIR)/data_mem.hex  $(OBJ_DIR)/data_mem.hex
	@if [ -f sw/ai_model/golden_vectors/ai_sram_init.hex ]; then cp sw/ai_model/golden_vectors/ai_sram_init.hex $(OBJ_DIR)/ai_sram_init.hex; fi
	@cd $(OBJ_DIR) && ./blogic_sim +CPB=434 +MEM_TRACE=$(MEM_TRACE) $(SIM_PLUSARGS) +TEST_NAME=$(TEST_NAME) +LOGDIR=$(SIM_LOG_DIR) \
	    2>&1 | tee $(SIM_LOG_DIR)/stdout.log
	@echo ""
	@python3 scripts/test_report.py $(TEST_NAME) $(SIM_LOG_DIR) --fw $(FW_SRC) || true
	@echo ""
	@echo "[SIM] Result:" && grep "^result=" $(SIM_LOG_DIR)/result.log

clean:
	rm -rf $(OBJ_DIR) $(BUILD_DIR)
	@echo "[CLEAN] Removed obj_dir/ and build/ (logs kept)"

logs-clean:
	rm -rf $(LOG_ROOT)
	@echo "[CLEAN] Removed logs/"

# riscv-arch-test icin buyuk bellekli sim; SoC konfigi (8 KB) degismez
verilate-arch:
	@$(MAKE) -f Makefile.verilator verilate OBJ_DIR=obj_dir_arch \
	    VLT_EXTRA="-GINSTR_SRAM_BYTES=1048576 -GDATA_SRAM_BYTES=65536"
