# ============================================================
# BLogic MCU - .gitignore
# ============================================================

# --- Verilator build dizinleri ---
obj_dir*/

# --- Genel build / log / venv ---
build/
logs/
venv/
.venv/
__pycache__/
*.pyc

# --- Verilator log / trace / waveform ---
*.log
*.vcd
*.fst
*.vvp
*.sim
verilator_log.txt
verilate.log
spike_trace.log
build_sw.log

# --- Derleme ara dosyalari ---
*.hex
*.bin
*.elf
*.o
*.d

# --- Coverage ---
*.cov
coverage.dat
coverage_html/

# --- Yedek / eski dosyalar ---
*.bak
*.bak2
*.old

# --- Editor / IDE ---
*.swp
*.swo
*~
.vscode/
.idea/

# ============================================================
# Istisnalar - bunlar repo'da KALSIN (asagi takip edilen hex'ler)
# ============================================================

# AI golden vector'lari (standalone TB + SoC test icin)

# Boot icin gerekli hex'ler

# TEKNOFEST resmi paket icerikleri
verif/arch_tests/riscv-arch-test/
*Zone.Identifier*
*:Zone.Identifier
# Uretilen artifakt: son --n degerine gore degisir (make ai / ai-batch1000).
# Deterministik kanit accuracy_report_n1000.txt olarak repoda kalir.
sw/ai_model/accuracy_report.txt

# --- istisnalar: repo icinde KALACAK dosyalar ---
!sw/ai_model/golden_vectors/*.hex
!sw/bootloader/bootrom.hex
!sw/bootloader/flash_helloworld.hex
# Questa dalga-formu akisinin firmware paketleri (verif/questa/README.md)
!verif/questa/fw/**/*.hex
!teknotest/**/*.hex
!teknotest/**/*.mem
!bootrom.hex
!rtl/fpga/firmware_flash.bin
# JTAG debug altsistemi (teslim cipinin parcasi): OpenOCD demo kanit loglari (sim + kart; make jtag-openocd / jtag-board)
!rtl/debug/openocd/demo_run_*.log

# ============================================================
# ASIC AKIS CIKTILARI (LibreLane)
# Her kosu ~100 MB / 1000+ dosya uretiyor - repoya girmemeli.
# Teslim icin secilen raporlar asic/reports/ altina ELLE kopyalanacak.
# ============================================================
asic/blocks/*/runs/
asic/**/runs/
*.AppImage

# Teslimde istenen generate-edilmis raporlar HARIC (jury "elle degistirilmemis" istiyor)
!asic/reports/**
!asic/results/**
!asic/checksums/**

# ============================================================
# docs/ TAMAMI YEREL - repoya girmez
# Plan, defter, duyuru metinleri, DTR/OTR dosyalari... hepsi yerelde kalir.
# Bilerek bir dosyayi commit'lemek istersen: git add -f docs/<dosya>
# ============================================================
docs/*
!docs/verification_and_test_plan.md
!docs/oznitelik_vektoru_formati.md

# FPGA bitstream (5.9 MB build ciktisi) - "git add -A" surekli topluyordu.
# Bilerek commit'lemek istersen: git add -f rtl/fpga/fpga_top.bit
rtl/fpga/*.bit

# ============================================================
# KISISEL / DAHILI - ASLA PUSHLANMAYACAK
# (Turkce karakterden kacinmak icin joker kullanildi)
# ============================================================
docs/soru_cevap_*
images/teknofest_toplanti_31072026.png

# ASIC calisma alanlari - yeniden uretilebilir, repoya girmez (DDK Tablo 8: run/ temiz teslim edilir)
asic/run/*
!asic/run/.gitkeep
asic/runs/

# demo-gunu paneli ve kart taramasinin yeniden uretilebilir ciktilari (tarihli kopyalar ayrica commit edilir)
juri_sonuclar_*.txt
juri_anlik_*.txt
juri_make_*.txt
juri_panel_log_*.txt
sw/ai_model/kart_sweep_raporu.txt
build/vivado_m2.log

# Questa / ModelSim kosu urunleri (verif/questa akisi kok dizinden de kosabilir)
modelsim.ini
transcript
*.wlf
vsim_stacktrace.vstf

# Questa run products written to the launch directory (verif/questa flow, tests with workdir .)
/transcript
/modelsim.ini
/vsim.wlf
/vsim_stacktrace.vstf

# flash_firmware.tcl ara urunleri (mcs/prm; kaynak firmware_flash.bin izlenir)
rtl/fpga/firmware_flash.mcs
rtl/fpga/firmware_flash.prm
