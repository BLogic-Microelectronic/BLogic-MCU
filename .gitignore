# ============================================================
# BLogic MCU - .gitignore
# ============================================================

# --- Verilator build dizinleri ---
obj_dir/
obj_dir_ai/
obj_dir_uvm/
obj_dir_boot/
obj_dir_qspi_modes/

# --- Genel build / log / venv ---
build/
logs/
venv/
.venv/
__pycache__/
*.pyc

# --- Verilator log / trace / waveform ---
*.log
*.vcd
*.fst
*.vvp
*.sim
verilator_log.txt
verilate.log
spike_trace.log
build_sw.log

# --- Derleme ara dosyalari ---
*.hex
*.bin
*.elf
*.o
*.d

# --- Coverage ---
*.cov
coverage.dat
coverage_html/

# --- Yedek / eski dosyalar ---
*.bak
*.bak2
*.old

# --- Editor / IDE ---
*.swp
*.swo
*~
.vscode/
.idea/

# ============================================================
# Istisnalar - bunlar repo'da KALSIN (asagi takip edilen hex'ler)
# ============================================================

# AI golden vector'lari (standalone TB + SoC test icin)
!sw/ai_model/golden_vectors/*.hex

# Boot icin gerekli hex'ler
!bootrom.hex
!flash.hex
!sw/bootloader/bootrom.hex

# TEKNOFEST resmi paket icerikleri
!teknotest/**/*.hex
!teknotest/**/*.mem
